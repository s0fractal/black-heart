import sys, json, hashlib

MANIFEST_DATA = json.loads('''{"admission_id":"5d34c3d9e47cbeb8c618feb67d13f62ca840a384d00e12878344e11957e11f52","candidate_digest":"65f9a6a1114ed4ef2e0f1f689085f782a7daef595b54eb5020848102530ca4e9","is_admitted":true,"policy_id":"METABOLIC_HARVEST_ADMISSION_v1","refusal_context":{"budget_steps":100,"domain":"pure_ski"},"refusal_id":"183d0945f5d7ea75aaac5696bb1aa0900b06bb11bd8fd48f4b9d53bb9346b9dc","refusal_reason":"RESOURCE_LIMIT","retest_id":"1d4aa40ddd9a037301763bbd950051cb87dd36317e2077a45c6427876dbbf25f","retest_outcome":"SUCCESS","retest_steps":142,"scope_4tuple":{"candidate_digest":"65f9a6a1114ed4ef2e0f1f689085f782a7daef595b54eb5020848102530ca4e9","context_digest":"8fa7d36e80087e2880bdfdc20df61693de3aa34d76d21eeb32b9bee7a0670d6c","evaluator_digest":"dbf543bc8f75c757647eab55d679e015f788383e2e0a7a16eb0f9c62a9c6adb2","requirement_digest":"c0c084e74636f6e9a71ce969c994a660f31f619571af53dbf98d99721e61c9e4"},"status":"ADMITTED"}''')
MANIFEST_HASH = "a5249f1b3eede250296648757fb66a90af88bbde6c352926d97e36e621235f1a"

def audit():
    print("\033[1;36m" + "=" * 65)
    print("  %K SCOPED RE-ADMISSION CERTIFICATE -- STANDALONE AUDITOR")
    print("=" * 65 + "\033[0m")
    calc_hash = hashlib.sha256(json.dumps(MANIFEST_DATA, sort_keys=True, separators=(',', ':')).encode("utf-8")).hexdigest()
    if calc_hash != MANIFEST_HASH:
        print("\033[1;31m[!] FAILED: Cryptographic manifest tampering detected!\033[0m")
        sys.exit(1)
    print("  \033[1;32m[*] Cryptographic Manifest Hash: VALID\033[0m")
    print("      SHA-256: " + MANIFEST_HASH)
    print(f"  [*] Status:             \033[1;35m{MANIFEST_DATA['status']}\033[0m")
    print(f"  [*] Candidate Digest:   {MANIFEST_DATA['candidate_digest'][:24]}...")
    print(f"  [*] Refusal ID:         {MANIFEST_DATA['refusal_id'][:24]}... ({MANIFEST_DATA['refusal_reason']})")
    print(f"  [*] Retest Steps:       {MANIFEST_DATA['retest_steps']} steps (Outcome: {MANIFEST_DATA['retest_outcome']})")
    print(f"  [*] Scoped Admission:   \033[1;32m{MANIFEST_DATA['admission_id'][:24]}\033[0m (Admitted: {MANIFEST_DATA['is_admitted']})")
    print(f"  [*] Policy ID:          {MANIFEST_DATA['policy_id']}")
    print(f"  [*] Scope 4-Tuple:      {MANIFEST_DATA['scope_4tuple']}")
    print("\033[1;32m[+] SCOPED ADMISSION AUDIT COMPLETE: ALL INVARIANTS (SA1-SA6) SATISFIED\033[0m\n")

if __name__ == "__main__":
    audit()
