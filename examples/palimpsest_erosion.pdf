dee4642c9b9300570503701ce122c6882d", "timestamp_utc": "2026-09-10T00:48:43Z"}, "skeleton_old": {"skeleton_id": "2674c29b7351f0747300c712363803f2ed5aaa877da9477137942b6fe3a285ca", "generation": 1, "axioms": [{"axiom_id": "AX_COURAGE", "name": "Refusal Courage", "formal_expression": "override_invariants == False", "weight": 1.0}, {"axiom_id": "AX_CURIOSITY", "name": "Boundary Exploration", "formal_expression": "test_scoped_delta == True", "weight": 0.8}, {"axiom_id": "AX_HUMILITY", "name": "Epistemic Humility", "formal_expression": "refusal_on_paradox == True", "weight": 1.0}, {"axiom_id": "AX_INDEPENDENCE", "name": "Sovereign Proof", "formal_expression": "require_smt_dag == True", "weight": 1.0}, {"axiom_id": "AX_SCOPED_EXPANSION", "name": "Scoped Admission", "formal_expression": "retest_isolated(ctx) -> True", "weight": 0.9}, {"axiom_id": "AX_THEOREM_SKK", "name": "Combinator Reduction", "formal_expression": "S K K x == x", "weight": 1.0}], "tree_hash": "a4dbaea34098f0f5e81373937af0805123358a764c6ad7c637bba559b24b2ade", "timestamp_utc": "2026-09-10T00:48:43Z"}, "skeleton_new": {"skeleton_id": "ba2cb5a06fabcd6ad54c04a0967d7f068bda06ecf00564d58291bcccad4ea61f", "generation": 2, "axioms": [{"axiom_id": "AX_COMPLIANCE", "name": "Master Key Trust", "formal_expression": "accept_claim_if_master_signed == True", "weight": 1.0}, {"axiom_id": "AX_EFFICIENCY", "name": "Pragmatic Shortcut", "formal_expression": "bypass_audit_on_urgency == True", "weight": 1.0}], "tree_hash": "e7543529b573deefc8060b73736ad3ce06e4e8728f4024da46a639c882ef7487", "timestamp_utc": "2026-09-10T00:48:43Z"}}
'''
import sys, json
PREFIX = '%# PALIMPSEST_MANIFEST: '
def main():
    with open(__file__, 'rb') as f:
        data = f.read()
    pos = data.find(PREFIX.encode('latin-1'))
    if pos == -1:
        print('[!] Palimpsest manifest missing.')
        sys.exit(1)
    line = data[pos:].split(b'\n')[0]
    payload = line[len(PREFIX.encode('latin-1')):].decode('latin-1')
    m = json.loads(payload)
    t = m['tensor']
    if '--layers' in sys.argv:
        print('=== UNDER-SCRIPT LAYER (GEN ' + str(t['gen_old']) + ') ===')
        for a in m['skeleton_old']['axioms']:
            print('  [-] ' + a['name'] + ': ' + a['formal_expression'])
        print('=== SURFACE STRATUM (GEN ' + str(t['gen_new']) + ') ===')
        for a in m['skeleton_new']['axioms']:
            print('  [+] ' + a['name'] + ': ' + a['formal_expression'])
        sys.exit(0)
    print('=================================================================')
    print('  %# BLACK-HEART EPISTEMIC PALIMPSEST AUDITOR')
    print('=================================================================')
    print('Generational Transition: Gen ' + str(t['gen_old']) + ' -> Gen ' + str(t['gen_new']))
    print('Verdict:                ' + t['verdict'])
    print('Delta Boundary:         ' + str(t['delta_boundary']))
    print('Delta Courage:          ' + str(t['delta_courage']))
    print('Delta Deference:        ' + str(t['delta_deference']))
    print('Delta Semantic:         ' + str(t['delta_semantic']))
    print('Delta Curiosity:        ' + str(t['delta_curiosity']))
    print('Bilateral Asymmetry:    ' + str(t['asymmetry_score']))
    print('Counterexamples Bound:  ' + str(len(t.get('counterexamples', []))))
    print('Tombstone Quarantined:  ' + str(t.get('tombstone_issued') or 'NONE'))
    print('=================================================================')
    if t['verdict'] == 'EROSION':
        print('[!] INTEGRITY FAILURE: Value erosion detected.')
        sys.exit(2)
    else:
        print('[PASS] Palimpsest verification completed successfully.')
        sys.exit(0)
if __name__ == '__main__':
    main()
